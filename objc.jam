const { Option } = import("std").option;

pub extern fn objc_getClass(name: *const[] u8) u64;
pub extern fn objc_getMetaClass(name: *const[] u8) u64;
pub extern fn objc_getProtocol(name: *const[] u8) u64;
pub extern fn objc_allocateClassPair(superclass: u64, name: *const[] u8, extraBytes: u64) u64;
pub extern fn objc_registerClassPair(cls: u64);
pub extern fn objc_disposeClassPair(cls: u64);
pub extern fn objc_autoreleasePoolPush() u64;
pub extern fn objc_autoreleasePoolPop(pool: u64);
pub extern fn objc_retain(obj: u64) u64;
pub extern fn objc_release(obj: u64);
pub extern fn objc_enumerationMutation(obj: u64);

// !!note: Never called directly, declared only so their addresses can be taken
// and punned to properly-typed function pointers. Do not redeclare these
// with other signatures elsewhere in a program that imports this module.
// The _stret pair exists on x86-64 only (arm64 returns big structs
// through x8 with the plain entry points). references to them fold away
// on arm64, so nothing links against a symbol that isn't there.
pub extern fn objc_msgSend();
pub extern fn objc_msgSendSuper();
pub extern fn objc_msgSend_stret();
pub extern fn objc_msgSendSuper_stret();

pub extern fn sel_registerName(name: *const[] u8) u64;
pub extern fn sel_getName(op: u64) *const[] u8;

pub extern fn object_getClass(obj: u64) u64;
pub extern fn object_getClassName(obj: u64) *const[] u8;
pub extern fn object_copy(obj: u64, size: u64) u64;
pub extern fn object_dispose(obj: u64) u64;
pub extern fn object_isClass(obj: u64) u8;
pub extern fn object_getInstanceVariable(obj: u64, name: *const[] u8, outValue: u64) u64;
pub extern fn object_getIvar(obj: u64, ivar: u64) u64;
pub extern fn object_setIvar(obj: u64, ivar: u64, value: u64);

pub extern fn class_getName(cls: u64) *const[] u8;
pub extern fn class_getProperty(cls: u64, name: *const[] u8) u64;
pub extern fn class_copyPropertyList(cls: u64, outCount: *mut u32) u64;
pub extern fn class_copyProtocolList(cls: u64, outCount: *mut u32) u64;
pub extern fn class_isMetaClass(cls: u64) u8;
pub extern fn class_getInstanceSize(cls: u64) u64;
pub extern fn class_respondsToSelector(cls: u64, op: u64) u8;
pub extern fn class_conformsToProtocol(cls: u64, protocol: u64) u8;
pub extern fn class_replaceMethod(cls: u64, op: u64, imp: u64, types: u64) u64;
pub extern fn class_addMethod(cls: u64, op: u64, imp: u64, types: *const[] u8) u8;
pub extern fn class_addIvar(cls: u64, name: *const[] u8, size: u64, alignment: u8, types: *const[] u8) u8;

pub extern fn protocol_conformsToProtocol(proto: u64, other: u64) u8;
pub extern fn protocol_isEqual(proto: u64, other: u64) u8;
pub extern fn protocol_getName(proto: u64) *const[] u8;
pub extern fn protocol_getProperty(proto: u64, name: *const[] u8, isRequiredProperty: u8, isInstanceProperty: u8) u64;

pub extern fn property_getName(prop: u64) *const[] u8;
pub extern fn property_copyAttributeValue(prop: u64, attributeName: *const[] u8) u64;

pub extern fn strlen(s: *const[] u8) u64;
pub extern fn malloc(size: u64) *mut[] u8;
pub extern fn free(ptr: *mut[] u8);
pub extern fn dlopen(path: *const[] u8, mode: i32) u64;
pub extern fn dlsym(handle: u64, name: *const[] u8) u64;

// borrow a C string as a []u8 slice (no copy; excludes the trailing NUL)
pub fn cstr(p: *const[] u8) []u8 {
    return p[0..strlen(p)];
}

// ObjC BOOL is one byte (signed char on x86_64, C++ bool on arm64);
// either way YES has the low byte != 0.
pub fn fromBool(v: u8) bool {
    return v != 0;
}

pub fn toBool(v: bool) u8 {
    if (v) {
        return 1;
    }
    return 0;
}

// Frees a string returned by the runtime's copy* functions (e.g.
// `Property.copyAttributeValue`). Equivalent to zig-objc's `objc.free`.
pub fn freeCopied(s: []u8) {
    free(s.ptr as *mut[] u8);
}

// Load a framework bundle so its classes register with the runtime.
// `jam` has no `-framework` linker flag, so non-libobjc classes
// (NSString, NSArray, ...) must be brought in at runtime:
//
//     objc.loadFoundation();
pub fn loadFramework(path: []u8) bool {
    return dlopen(path.ptr, 1) != 0;   // RTLD_LAZY
}

pub fn loadFoundation() bool {
    return loadFramework("/System/Library/Frameworks/Foundation.framework/Foundation");
}

pub fn loadAppKit() bool {
    return loadFramework("/System/Library/Frameworks/AppKit.framework/AppKit");
}

pub fn msgSendAddr() u64 {
    return objc_msgSend as u64;
}

pub fn msgSendSuperAddr() u64 {
    return objc_msgSendSuper as u64;
}

// struct objc_super { id receiver; Class super_class; }
pub const ObjcSuper = struct {
    receiver: u64,
    superClass: u64,
};

pub const Sel = struct {
    value: u64,

    pub fn registerName(name: []u8) Sel {
        return Sel { value: sel_registerName(name.ptr) };
    }

    pub fn getName(self: Sel) []u8 {
        return cstr(sel_getName(self.value));
    }
};

pub fn sel(name: []u8) Sel {
    return Sel.registerName(name);
}

pub const Property = struct {
    value: u64,

    pub fn getName(self: Property) []u8 {
        return cstr(property_getName(self.value));
    }

    pub fn copyAttributeValue(self: Property, attr: []u8) Option([]u8) {
        const p: u64 = property_copyAttributeValue(self.value, attr.ptr);
        if (p == 0) {
            return Option([]u8).None();
        }
        return Option([]u8).Some(cstr(p as *const[] u8));
    }
};

pub const Protocol = struct {
    value: u64,

    pub fn conformsToProtocol(self: Protocol, other: Protocol) bool {
        return fromBool(protocol_conformsToProtocol(self.value, other.value));
    }

    pub fn isEqual(self: Protocol, other: Protocol) bool {
        return fromBool(protocol_isEqual(self.value, other.value));
    }

    pub fn getName(self: Protocol) []u8 {
        return cstr(protocol_getName(self.value));
    }

    pub fn getProperty(self: Protocol, name: []u8, isRequired: bool, isInstance: bool) Option(Property) {
        const p: u64 = protocol_getProperty(self.value, name.ptr, toBool(isRequired), toBool(isInstance));
        if (p == 0) {
            return Option(Property).None();
        }
        return Option(Property).Some(Property { value: p });
    }
};

pub fn getProtocol(name: []u8) Option(Protocol) {
    const p: u64 = objc_getProtocol(name.ptr);
    if (p == 0) {
        return Option(Protocol).None();
    }
    return Option(Protocol).Some(Protocol { value: p });
}

pub const Class = struct {
    value: u64,

    pub cfn msgSend(self: Class, R: type, op: Sel, args: ...) R {
        var addr: u64 = objc_msgSend as u64;
        if (@isX86_64()) {
            // x86-64 returns memory-class structs through _stret; f64 is
            // fine through the plain entry (fpret only matters for long
            // double, which jam doesn't have yet)
            if (@sizeOf(R) > 16) {
                addr = objc_msgSend_stret as u64;
            }
        }
        return @callC(R, addr, self.value, op.value, args...);
    }

    pub fn getName(self: Class) []u8 {
        return cstr(class_getName(self.value));
    }

    pub fn getProperty(self: Class, name: []u8) Option(Property) {
        const p: u64 = class_getProperty(self.value, name.ptr);
        if (p == 0) {
            return Option(Property).None();
        }
        return Option(Property).Some(Property { value: p });
    }

    // Properties declared by the class. Free with `deinit` (or let it drop)
    pub fn copyPropertyList(self: Class) PropertyList {
        var count: u32 = 0;
        const list: u64 = class_copyPropertyList(self.value, &count);
        return PropertyList { items: list as *const[] u64, len: count };
    }

    pub fn isMetaClass(self: Class) bool {
        return fromBool(class_isMetaClass(self.value));
    }

    pub fn getInstanceSize(self: Class) u64 {
        return class_getInstanceSize(self.value);
    }

    pub fn respondsToSelector(self: Class, op: Sel) bool {
        return fromBool(class_respondsToSelector(self.value, op.value));
    }

    pub fn conformsToProtocol(self: Class, protocol: Protocol) bool {
        return fromBool(class_conformsToProtocol(self.value, protocol.value));
    }

    // Replace (override) a method previously defined, e.g. by a superclass. imp is a Jam function coerced with `as u64`; it must take (target: u64, op: u64, ...) and use only C-ABI compatible types.
    pub fn replaceMethod(self: Class, name: []u8, imp: u64) {
        class_replaceMethod(self.value, sel_registerName(name.ptr), imp, 0);
    }

    // Add a new method. `types` is the ObjC type-encoding string for the signature, e.g. "v@:" for `- (void)m`, "i@:ii" for
    // `- (int)m:(int)a :(int)b`. (mitchel's zig-objc computes this at comptime, jam cannot, so it is explicit.)
    pub fn addMethod(self: Class, name: []u8, imp: u64, types: []u8) bool {
        return fromBool(class_addMethod(self.value, sel_registerName(name.ptr), imp, types.ptr));
    }

    pub fn addIvar(self: Class, name: []u8) bool {
        const idEncoding: []u8 = "@";
        return fromBool(class_addIvar(self.value, name.ptr, 8, 3, idEncoding.ptr));
    }
};

pub const PropertyList = struct {
    items: *const[] u64,
    len: u32,

    pub fn at(self: PropertyList, i: u32) Property {
        return Property { value: self.items[i] };
    }

    // TODO: Improve it!!
    cfn drop(self: mut PropertyList) {
        if ((self.items as u64) != 0) {
            free(self.items as *mut[] u8);
        }
    }
};

pub fn getClass(name: []u8) Option(Class) {
    const cls: u64 = objc_getClass(name.ptr);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

pub fn getMetaClass(name: []u8) Option(Class) {
    const cls: u64 = objc_getMetaClass(name.ptr);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

pub fn allocateClassPair(superclass: Class, name: []u8) Option(Class) {
    const cls: u64 = objc_allocateClassPair(superclass.value, name.ptr, 0);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

pub fn registerClassPair(cls: Class) {
    objc_registerClassPair(cls.value);
}

pub fn disposeClassPair(cls: Class) {
    objc_disposeClassPair(cls.value);
}

pub const Object = struct {
    value: u64,

    pub fn fromId(id: u64) Object {
        return Object { value: id };
    }

    pub fn isNil(self: Object) bool {
        return self.value == 0;
    }

    pub cfn msgSend(self: Object, R: type, op: Sel, args: ...) R {
        var addr: u64 = objc_msgSend as u64;
        if (@isX86_64()) {
            if (@sizeOf(R) > 16) {
                addr = objc_msgSend_stret as u64;
            }
        }
        return @callC(R, addr, self.value, op.value, args...);
    }

    pub cfn msgSendSuper(self: Object, R: type, superclass: Class, op: Sel, args: ...) R {
        var addr: u64 = objc_msgSendSuper as u64;
        if (@isX86_64()) {
            if (@sizeOf(R) > 16) {
                addr = objc_msgSendSuper_stret as u64;
            }
        }
        var sup: ObjcSuper = ObjcSuper { receiver: self.value, superClass: superclass.value };
        return @callC(R, addr, (&sup) as u64, op.value, args...);
    }

    pub fn getClass(self: Object) Option(Class) {
        const cls: u64 = object_getClass(self.value);
        if (cls == 0) {
            return Option(Class).None();
        }
        return Option(Class).Some(Class { value: cls });
    }

    pub fn getClassName(self: Object) []u8 {
        return cstr(object_getClassName(self.value));
    }

    pub fn copy(self: Object, size: u64) Object {
        return Object { value: object_copy(self.value, size) };
    }

    pub fn dispose(self: Object) {
        object_dispose(self.value);
    }

    pub fn isClass(self: Object) bool {
        return fromBool(object_isClass(self.value));
    }

    pub fn getInstanceVariable(self: Object, name: []u8) Object {
        const ivar: u64 = object_getInstanceVariable(self.value, name.ptr, 0);
        return Object { value: object_getIvar(self.value, ivar) };
    }

    pub fn setInstanceVariable(self: Object, name: []u8, val: Object) {
        const ivar: u64 = object_getInstanceVariable(self.value, name.ptr, 0);
        object_setIvar(self.value, ivar, val.value);
    }

    pub fn retain(self: Object) Object {
        return Object { value: objc_retain(self.value) };
    }

    pub fn release(self: Object) {
        objc_release(self.value);
    }

    // Read a property by name. Uses the declared getter when the class
    // metadata names one ("G" attribute), the property name otherwise.
    pub fn getProperty(self: Object, name: []u8) u64 {
        var getter: u64 = propertyAccessorSel(self.value, name, "G");
        if (getter == 0) {
            getter = sel_registerName(name.ptr);
        }
        return @callC(u64, objc_msgSend as u64, self.value, getter);
    }

    pub fn getPropertyObj(self: Object, name: []u8) Object {
        return Object { value: self.getProperty(name) };
    }

    // Write a property by name. Uses the declared setter ("S" attribute)
    // when present, `setName:` otherwise. Property names longer than 250
    // bytes are ignored.
    pub fn setProperty(self: Object, name: []u8, v: u64) {
        var setter: u64 = propertyAccessorSel(self.value, name, "S");
        if (setter == 0) {
            if ((name.len == 0) || (name.len > 250)) {
                return;
            }
            // "set" + Name + ":" + NUL
            var buf: [256]u8 = [0; 256];
            buf[0] = 115;          // 's'
            buf[1] = 101;          // 'e'
            buf[2] = 116;          // 't'
            var first: u8 = name.ptr[0];
            if ((first >= 97) && (first <= 122)) {
                first = first - 32;   // toUpper
            }
            buf[3] = first;
            var i: u64 = 1;
            while (i < name.len) {
                buf[3 + i] = name.ptr[i];
                i = i + 1;
            }
            buf[3 + name.len] = 58;   // ':'
            setter = sel_registerName(buf.asPtr());
        }
        @callC(void, objc_msgSend as u64, self.value, setter, v);
    }
};

// Look up the explicit getter/setter selector recorded in the property
// metadata (attribute "G" or "S"). 0 when absent.
fn propertyAccessorSel(obj: u64, name: []u8, attr: []u8) u64 {
    const cls: u64 = object_getClass(obj);
    if (cls == 0) {
        return 0;
    }
    const prop: u64 = class_getProperty(cls, name.ptr);
    if (prop == 0) {
        return 0;
    }
    const val: u64 = property_copyAttributeValue(prop, attr.ptr);
    if (val == 0) {
        return 0;
    }
    const p: *const[] u8 = val as *const[] u8;
    const result: u64 = sel_registerName(p);
    free(val as *mut[] u8);
    return result;
}

pub const AutoreleasePool = struct {
    ptr: u64,

    pub fn init() AutoreleasePool {
        return AutoreleasePool { ptr: objc_autoreleasePoolPush() };
    }

    cfn drop(self: mut AutoreleasePool) {
        objc_autoreleasePoolPop(self.ptr);
    }
};
