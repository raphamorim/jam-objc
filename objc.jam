// jam-objc — Objective-C runtime bindings for Jam.
//
// A port of mitchellh/zig-objc (vendored in references/zig-objc) to the
// Jam language. The core trick is the same as the Zig original: the
// address of `objc_msgSend` is cast to a function pointer matching the
// *target method's* signature and called through that, so arguments and
// returns travel in the registers the C ABI expects. Jam has no
// `@ptrCast`, so the cast goes through an untagged union instead
// (see the `Sig*` unions below).
//
// Differences from zig-objc, forced by Jam (no comptime reflection):
//   * msgSend is arity/shape-suffixed (`msgSend0..4`, `msgSendF*`,
//     `msgSendD*`) instead of generic over a tuple. Receivers, objects,
//     selectors, and pointers all travel as `u64`.
//   * Methods that return (or take) structs by value — NSRange, NSRect,
//     CGRect, ... — work via a custom `Sig*` union whose `f` field has
//     the struct in the signature (e.g. `fn(u64, u64) NSRect`). The
//     library doesn't ship those shapes; declare your own per method.
//     Requires a jam built at/after the C-ABI aggregate fix (older
//     jams miscompiled struct args/returns through fn-pointer calls).
//   * `addMethod` takes an explicit ObjC type-encoding string ("v@:",
//     "i@:ii", ...) — there is no comptime encoder.
//
// Naming follows zig-objc where a direct equivalent exists.
//
// All C strings passed in ([]u8 names) must be null-terminated; Jam
// string literals are.

const { Option } = import("std").option;

// ---------------------------------------------------------------------------
// Raw Objective-C runtime ABI (<objc/runtime.h>, <objc/message.h>).
// `pub` so they stay visible when pub fns here are codegen'd in an
// importer's compilation context (same pattern as std.process).
// `id`, `Class`, `SEL`, `Protocol*`, `Ivar`, `objc_property_t` are all
// pointer-sized — they travel as u64 throughout.

pub extern fn objc_getClass(name: *const[] u8) u64;
pub extern fn objc_getMetaClass(name: *const[] u8) u64;
pub extern fn objc_getProtocol(name: *const[] u8) u64;
pub extern fn objc_allocateClassPair(superclass: u64, name: *const[] u8, extraBytes: u64) u64;
pub extern fn objc_registerClassPair(cls: u64);
pub extern fn objc_disposeClassPair(cls: u64);
pub extern fn objc_autoreleasePoolPush() u64;
pub extern fn objc_autoreleasePoolPop(pool: u64);
pub extern fn objc_retain(obj: u64) u64;
pub extern fn objc_release(obj: u64);
pub extern fn objc_enumerationMutation(obj: u64);

// Never called directly — declared only so their addresses can be taken
// and punned to properly-typed function pointers. Do not redeclare these
// with other signatures elsewhere in a program that imports this module.
pub extern fn objc_msgSend();
pub extern fn objc_msgSendSuper();

pub extern fn sel_registerName(name: *const[] u8) u64;
pub extern fn sel_getName(op: u64) *const[] u8;

pub extern fn object_getClass(obj: u64) u64;
pub extern fn object_getClassName(obj: u64) *const[] u8;
pub extern fn object_copy(obj: u64, size: u64) u64;
pub extern fn object_dispose(obj: u64) u64;
pub extern fn object_isClass(obj: u64) u8;
pub extern fn object_getInstanceVariable(obj: u64, name: *const[] u8, outValue: u64) u64;
pub extern fn object_getIvar(obj: u64, ivar: u64) u64;
pub extern fn object_setIvar(obj: u64, ivar: u64, value: u64);

pub extern fn class_getName(cls: u64) *const[] u8;
pub extern fn class_getProperty(cls: u64, name: *const[] u8) u64;
pub extern fn class_copyPropertyList(cls: u64, outCount: *mut u32) u64;
pub extern fn class_copyProtocolList(cls: u64, outCount: *mut u32) u64;
pub extern fn class_isMetaClass(cls: u64) u8;
pub extern fn class_getInstanceSize(cls: u64) u64;
pub extern fn class_respondsToSelector(cls: u64, op: u64) u8;
pub extern fn class_conformsToProtocol(cls: u64, protocol: u64) u8;
pub extern fn class_replaceMethod(cls: u64, op: u64, imp: u64, types: u64) u64;
pub extern fn class_addMethod(cls: u64, op: u64, imp: u64, types: *const[] u8) u8;
pub extern fn class_addIvar(cls: u64, name: *const[] u8, size: u64, alignment: u8, types: *const[] u8) u8;

pub extern fn protocol_conformsToProtocol(proto: u64, other: u64) u8;
pub extern fn protocol_isEqual(proto: u64, other: u64) u8;
pub extern fn protocol_getName(proto: u64) *const[] u8;
pub extern fn protocol_getProperty(proto: u64, name: *const[] u8, isRequiredProperty: u8, isInstanceProperty: u8) u64;

pub extern fn property_getName(prop: u64) *const[] u8;
pub extern fn property_copyAttributeValue(prop: u64, attributeName: *const[] u8) u64;

// libc / libSystem
pub extern fn strlen(s: *const[] u8) u64;
pub extern fn malloc(size: u64) *mut[] u8;
pub extern fn free(ptr: *mut[] u8);
pub extern fn dlopen(path: *const[] u8, mode: i32) u64;
pub extern fn dlsym(handle: u64, name: *const[] u8) u64;

// ---------------------------------------------------------------------------
// Helpers

// Borrow a C string as a []u8 slice (no copy; excludes the trailing NUL).
pub fn cstr(p: *const[] u8) []u8 {
    return p[0..strlen(p)];
}

// ObjC BOOL is one byte (signed char on x86_64, C++ bool on arm64);
// either way YES has the low byte != 0.
pub fn fromBool(v: u8) bool {
    return v != 0;
}

pub fn toBool(v: bool) u8 {
    if (v) {
        return 1;
    }
    return 0;
}

// Frees a string returned by the runtime's copy* functions (e.g.
// `Property.copyAttributeValue`). Equivalent to zig-objc's `objc.free`.
pub fn freeCopied(s: []u8) {
    free(s.ptr as *mut[] u8);
}

// Load a framework bundle so its classes register with the runtime.
// `jam` has no `-framework` linker flag, so non-libobjc classes
// (NSString, NSArray, ...) must be brought in at runtime:
//
//     objc.loadFoundation();
pub fn loadFramework(path: []u8) bool {
    return dlopen(path.ptr, 1) != 0;   // RTLD_LAZY
}

pub fn loadFoundation() bool {
    return loadFramework("/System/Library/Frameworks/Foundation.framework/Foundation");
}

pub fn loadAppKit() bool {
    return loadFramework("/System/Library/Frameworks/AppKit.framework/AppKit");
}

// ---------------------------------------------------------------------------
// msgSend
//
// objc_msgSend must be called as if it were the target method (see the
// long comment in references/zig-objc/src/msg_send.zig). Each `Sig*`
// union puns the function's address into one concrete shape:
//
//   sigN   : N u64 args -> u64    (ids, pointers, integers, bools, void)
//   sigFN  : N u64 args -> f64    (CGFloat / NSTimeInterval returns)
//   sigDN  : N f64 args -> u64    (CGFloat arguments)
//
// u64 covers every pointer-sized scalar; narrower C integer arguments
// (int, BOOL, ...) are widened into the same registers, which the
// arm64 and x86_64 C ABIs both permit for callee-narrowed parameters.
//
// `msgSendAddr`/`msgSendSuperAddr` are public so user code can pun
// signatures this module doesn't ship (e.g. mixed int/float argument
// lists) — define your own union in your module:
//
//     const MySig = union { addr: u64, f: fn(u64, u64, f64, u64) u64 };

pub const Sig0 = union { addr: u64, f: fn(u64, u64) u64 };
pub const Sig1 = union { addr: u64, f: fn(u64, u64, u64) u64 };
pub const Sig2 = union { addr: u64, f: fn(u64, u64, u64, u64) u64 };
pub const Sig3 = union { addr: u64, f: fn(u64, u64, u64, u64, u64) u64 };
pub const Sig4 = union { addr: u64, f: fn(u64, u64, u64, u64, u64, u64) u64 };
pub const SigF0 = union { addr: u64, f: fn(u64, u64) f64 };
pub const SigF1 = union { addr: u64, f: fn(u64, u64, u64) f64 };
pub const SigD1 = union { addr: u64, f: fn(u64, u64, f64) u64 };
pub const SigD2 = union { addr: u64, f: fn(u64, u64, f64, f64) u64 };

pub fn msgSendAddr() u64 {
    return objc_msgSend as u64;
}

pub fn msgSendSuperAddr() u64 {
    return objc_msgSendSuper as u64;
}

pub fn rawSend0(target: u64, op: u64) u64 {
    var caster: Sig0 = Sig0 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64) u64 = caster.f;
    return send(target, op);
}

pub fn rawSend1(target: u64, op: u64, a: u64) u64 {
    var caster: Sig1 = Sig1 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, u64) u64 = caster.f;
    return send(target, op, a);
}

pub fn rawSend2(target: u64, op: u64, a: u64, b: u64) u64 {
    var caster: Sig2 = Sig2 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, u64, u64) u64 = caster.f;
    return send(target, op, a, b);
}

pub fn rawSend3(target: u64, op: u64, a: u64, b: u64, c3: u64) u64 {
    var caster: Sig3 = Sig3 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, u64, u64, u64) u64 = caster.f;
    return send(target, op, a, b, c3);
}

pub fn rawSend4(target: u64, op: u64, a: u64, b: u64, c4: u64, d: u64) u64 {
    var caster: Sig4 = Sig4 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, u64, u64, u64, u64) u64 = caster.f;
    return send(target, op, a, b, c4, d);
}

pub fn rawSendF0(target: u64, op: u64) f64 {
    var caster: SigF0 = SigF0 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64) f64 = caster.f;
    return send(target, op);
}

pub fn rawSendF1(target: u64, op: u64, a: u64) f64 {
    var caster: SigF1 = SigF1 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, u64) f64 = caster.f;
    return send(target, op, a);
}

pub fn rawSendD1(target: u64, op: u64, a: f64) u64 {
    var caster: SigD1 = SigD1 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, f64) u64 = caster.f;
    return send(target, op, a);
}

pub fn rawSendD2(target: u64, op: u64, a: f64, b: f64) u64 {
    var caster: SigD2 = SigD2 { addr: objc_msgSend as u64 };
    var send: fn(u64, u64, f64, f64) u64 = caster.f;
    return send(target, op, a, b);
}

// struct objc_super { id receiver; Class super_class; }
pub const ObjcSuper = struct {
    receiver: u64,
    superClass: u64,
};

pub fn rawSendSuper0(receiver: u64, superclass: u64, op: u64) u64 {
    var sup: ObjcSuper = ObjcSuper { receiver: receiver, superClass: superclass };
    var caster: Sig0 = Sig0 { addr: objc_msgSendSuper as u64 };
    var send: fn(u64, u64) u64 = caster.f;
    return send((&sup) as u64, op);
}

pub fn rawSendSuper1(receiver: u64, superclass: u64, op: u64, a: u64) u64 {
    var sup: ObjcSuper = ObjcSuper { receiver: receiver, superClass: superclass };
    var caster: Sig1 = Sig1 { addr: objc_msgSendSuper as u64 };
    var send: fn(u64, u64, u64) u64 = caster.f;
    return send((&sup) as u64, op, a);
}

pub fn rawSendSuper2(receiver: u64, superclass: u64, op: u64, a: u64, b: u64) u64 {
    var sup: ObjcSuper = ObjcSuper { receiver: receiver, superClass: superclass };
    var caster: Sig2 = Sig2 { addr: objc_msgSendSuper as u64 };
    var send: fn(u64, u64, u64, u64) u64 = caster.f;
    return send((&sup) as u64, op, a, b);
}

// ---------------------------------------------------------------------------
// Sel

pub const Sel = struct {
    value: u64,

    // Registers a method name with the runtime and returns the selector.
    pub fn registerName(name: []u8) Sel {
        return Sel { value: sel_registerName(name.ptr) };
    }

    // Returns the name of the method this selector refers to.
    pub fn getName(self: Sel) []u8 {
        return cstr(sel_getName(self.value));
    }
};

// Shorthand, equivalent to Sel.registerName (zig-objc: `objc.sel`).
pub fn sel(name: []u8) Sel {
    return Sel.registerName(name);
}

// ---------------------------------------------------------------------------
// Property

pub const Property = struct {
    value: u64,

    // Returns the name of a property.
    pub fn getName(self: Property) []u8 {
        return cstr(property_getName(self.value));
    }

    // Returns the value of a property attribute ("G", "S", "T", ...).
    // The returned string is malloc'd: release it with objc.freeCopied.
    pub fn copyAttributeValue(self: Property, attr: []u8) Option([]u8) {
        const p: u64 = property_copyAttributeValue(self.value, attr.ptr);
        if (p == 0) {
            return Option([]u8).None();
        }
        return Option([]u8).Some(cstr(p as *const[] u8));
    }
};

// ---------------------------------------------------------------------------
// Protocol

pub const Protocol = struct {
    value: u64,

    pub fn conformsToProtocol(self: Protocol, other: Protocol) bool {
        return fromBool(protocol_conformsToProtocol(self.value, other.value));
    }

    pub fn isEqual(self: Protocol, other: Protocol) bool {
        return fromBool(protocol_isEqual(self.value, other.value));
    }

    pub fn getName(self: Protocol) []u8 {
        return cstr(protocol_getName(self.value));
    }

    pub fn getProperty(self: Protocol, name: []u8, isRequired: bool, isInstance: bool) Option(Property) {
        const p: u64 = protocol_getProperty(self.value, name.ptr, toBool(isRequired), toBool(isInstance));
        if (p == 0) {
            return Option(Property).None();
        }
        return Option(Property).Some(Property { value: p });
    }
};

pub fn getProtocol(name: []u8) Option(Protocol) {
    const p: u64 = objc_getProtocol(name.ptr);
    if (p == 0) {
        return Option(Protocol).None();
    }
    return Option(Protocol).Some(Protocol { value: p });
}

// ---------------------------------------------------------------------------
// Class

pub const Class = struct {
    value: u64,

    // -- message sending (class methods). Returns are raw u64; use
    //    msgSendObjN when the method returns an object.

    // One generic send over @callC — the suffixed wrappers below are
    // now just shorthand for it.
    pub cfn msgSend(self: Class, R: type, op: Sel, args: ...) R {
        return @callC(R, objc_msgSend as u64, self.value, op.value, args...);
    }

    pub fn msgSend0(self: Class, op: Sel) u64 {
        return rawSend0(self.value, op.value);
    }

    pub fn msgSend1(self: Class, op: Sel, a: u64) u64 {
        return rawSend1(self.value, op.value, a);
    }

    pub fn msgSend2(self: Class, op: Sel, a: u64, b: u64) u64 {
        return rawSend2(self.value, op.value, a, b);
    }

    pub fn msgSend3(self: Class, op: Sel, a: u64, b: u64, c3: u64) u64 {
        return rawSend3(self.value, op.value, a, b, c3);
    }

    pub fn msgSend4(self: Class, op: Sel, a: u64, b: u64, c4: u64, d: u64) u64 {
        return rawSend4(self.value, op.value, a, b, c4, d);
    }

    pub fn msgSendObj0(self: Class, op: Sel) Object {
        return Object { value: rawSend0(self.value, op.value) };
    }

    pub fn msgSendObj1(self: Class, op: Sel, a: u64) Object {
        return Object { value: rawSend1(self.value, op.value, a) };
    }

    pub fn msgSendObj2(self: Class, op: Sel, a: u64, b: u64) Object {
        return Object { value: rawSend2(self.value, op.value, a, b) };
    }

    pub fn msgSendF0(self: Class, op: Sel) f64 {
        return rawSendF0(self.value, op.value);
    }

    pub fn msgSendD1(self: Class, op: Sel, a: f64) u64 {
        return rawSendD1(self.value, op.value, a);
    }

    // -- runtime queries

    pub fn getName(self: Class) []u8 {
        return cstr(class_getName(self.value));
    }

    // Returns a property with the given name, if declared.
    pub fn getProperty(self: Class, name: []u8) Option(Property) {
        const p: u64 = class_getProperty(self.value, name.ptr);
        if (p == 0) {
            return Option(Property).None();
        }
        return Option(Property).Some(Property { value: p });
    }

    // Properties declared by the class. Free with `deinit` (or let it drop).
    pub fn copyPropertyList(self: Class) PropertyList {
        var count: u32 = 0;
        const list: u64 = class_copyPropertyList(self.value, &count);
        return PropertyList { items: list as *const[] u64, len: count };
    }

    pub fn isMetaClass(self: Class) bool {
        return fromBool(class_isMetaClass(self.value));
    }

    pub fn getInstanceSize(self: Class) u64 {
        return class_getInstanceSize(self.value);
    }

    pub fn respondsToSelector(self: Class, op: Sel) bool {
        return fromBool(class_respondsToSelector(self.value, op.value));
    }

    pub fn conformsToProtocol(self: Class, protocol: Protocol) bool {
        return fromBool(class_conformsToProtocol(self.value, protocol.value));
    }

    // -- class construction (between allocateClassPair / registerClassPair)

    // Replace (override) a method previously defined, e.g. by a superclass.
    // `imp` is a Jam function coerced with `as u64`; it must take
    // (target: u64, op: u64, ...) and use only C-ABI compatible types.
    pub fn replaceMethod(self: Class, name: []u8, imp: u64) {
        class_replaceMethod(self.value, sel_registerName(name.ptr), imp, 0);
    }

    // Add a new method. `types` is the ObjC type-encoding string for the
    // signature, e.g. "v@:" for `- (void)m`, "i@:ii" for
    // `- (int)m:(int)a :(int)b`. (zig-objc computes this at comptime;
    // Jam cannot, so it is explicit.)
    pub fn addMethod(self: Class, name: []u8, imp: u64, types: []u8) bool {
        return fromBool(class_addMethod(self.value, sel_registerName(name.ptr), imp, types.ptr));
    }

    // Add an ivar of type `id`. Only valid between allocateClassPair and
    // registerClassPair.
    pub fn addIvar(self: Class, name: []u8) bool {
        const idEncoding: []u8 = "@";
        return fromBool(class_addIvar(self.value, name.ptr, 8, 3, idEncoding.ptr));
    }
};

// Result of Class.copyPropertyList — a malloc'd array of objc_property_t.
pub const PropertyList = struct {
    items: *const[] u64,
    len: u32,

    pub fn at(self: PropertyList, i: u32) Property {
        return Property { value: self.items[i] };
    }

    // `cfn drop` (not `fn drop`) is what registers with MVS auto-drop —
    // a plain `fn drop` is just a method and never fires at scope exit.
    cfn drop(self: mut PropertyList) {
        if ((self.items as u64) != 0) {
            free(self.items as *mut[] u8);
        }
    }
};

pub fn getClass(name: []u8) Option(Class) {
    const cls: u64 = objc_getClass(name.ptr);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

pub fn getMetaClass(name: []u8) Option(Class) {
    const cls: u64 = objc_getMetaClass(name.ptr);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

// Begin by calling this, then registerClassPair on the result when done.
pub fn allocateClassPair(superclass: Class, name: []u8) Option(Class) {
    const cls: u64 = objc_allocateClassPair(superclass.value, name.ptr, 0);
    if (cls == 0) {
        return Option(Class).None();
    }
    return Option(Class).Some(Class { value: cls });
}

pub fn registerClassPair(cls: Class) {
    objc_registerClassPair(cls.value);
}

pub fn disposeClassPair(cls: Class) {
    objc_disposeClassPair(cls.value);
}

// ---------------------------------------------------------------------------
// Object

pub const Object = struct {
    value: u64,

    // Convert a raw `id` into an Object. Tagged pointers (NSNumber,
    // short NSStrings, ...) are plain u64s here, so unaligned tagged
    // pointer values are handled for free.
    pub fn fromId(id: u64) Object {
        return Object { value: id };
    }

    pub fn isNil(self: Object) bool {
        return self.value == 0;
    }

    // -- message sending (instance methods)

    pub cfn msgSend(self: Object, R: type, op: Sel, args: ...) R {
        return @callC(R, objc_msgSend as u64, self.value, op.value, args...);
    }

    pub cfn msgSendSuper(self: Object, R: type, superclass: Class, op: Sel, args: ...) R {
        var sup: ObjcSuper = ObjcSuper { receiver: self.value, superClass: superclass.value };
        return @callC(R, objc_msgSendSuper as u64, (&sup) as u64, op.value, args...);
    }

    pub fn msgSend0(self: Object, op: Sel) u64 {
        return rawSend0(self.value, op.value);
    }

    pub fn msgSend1(self: Object, op: Sel, a: u64) u64 {
        return rawSend1(self.value, op.value, a);
    }

    pub fn msgSend2(self: Object, op: Sel, a: u64, b: u64) u64 {
        return rawSend2(self.value, op.value, a, b);
    }

    pub fn msgSend3(self: Object, op: Sel, a: u64, b: u64, c3: u64) u64 {
        return rawSend3(self.value, op.value, a, b, c3);
    }

    pub fn msgSend4(self: Object, op: Sel, a: u64, b: u64, c4: u64, d: u64) u64 {
        return rawSend4(self.value, op.value, a, b, c4, d);
    }

    pub fn msgSendObj0(self: Object, op: Sel) Object {
        return Object { value: rawSend0(self.value, op.value) };
    }

    pub fn msgSendObj1(self: Object, op: Sel, a: u64) Object {
        return Object { value: rawSend1(self.value, op.value, a) };
    }

    pub fn msgSendObj2(self: Object, op: Sel, a: u64, b: u64) Object {
        return Object { value: rawSend2(self.value, op.value, a, b) };
    }

    // f64 (CGFloat / NSTimeInterval / double) returns.
    pub fn msgSendF0(self: Object, op: Sel) f64 {
        return rawSendF0(self.value, op.value);
    }

    pub fn msgSendF1(self: Object, op: Sel, a: u64) f64 {
        return rawSendF1(self.value, op.value, a);
    }

    // f64 arguments.
    pub fn msgSendD1(self: Object, op: Sel, a: f64) u64 {
        return rawSendD1(self.value, op.value, a);
    }

    pub fn msgSendD2(self: Object, op: Sel, a: f64, b: f64) u64 {
        return rawSendD2(self.value, op.value, a, b);
    }

    // Invoke a selector on the superclass (objc_msgSendSuper).
    pub fn msgSendSuper0(self: Object, superclass: Class, op: Sel) u64 {
        return rawSendSuper0(self.value, superclass.value, op.value);
    }

    pub fn msgSendSuper1(self: Object, superclass: Class, op: Sel, a: u64) u64 {
        return rawSendSuper1(self.value, superclass.value, op.value, a);
    }

    pub fn msgSendSuper2(self: Object, superclass: Class, op: Sel, a: u64, b: u64) u64 {
        return rawSendSuper2(self.value, superclass.value, op.value, a, b);
    }

    // -- runtime queries

    pub fn getClass(self: Object) Option(Class) {
        const cls: u64 = object_getClass(self.value);
        if (cls == 0) {
            return Option(Class).None();
        }
        return Option(Class).Some(Class { value: cls });
    }

    pub fn getClassName(self: Object) []u8 {
        return cstr(object_getClassName(self.value));
    }

    pub fn copy(self: Object, size: u64) Object {
        return Object { value: object_copy(self.value, size) };
    }

    pub fn dispose(self: Object) {
        object_dispose(self.value);
    }

    pub fn isClass(self: Object) bool {
        return fromBool(object_isClass(self.value));
    }

    pub fn getInstanceVariable(self: Object, name: []u8) Object {
        const ivar: u64 = object_getInstanceVariable(self.value, name.ptr, 0);
        return Object { value: object_getIvar(self.value, ivar) };
    }

    pub fn setInstanceVariable(self: Object, name: []u8, val: Object) {
        const ivar: u64 = object_getInstanceVariable(self.value, name.ptr, 0);
        object_setIvar(self.value, ivar, val.value);
    }

    // -- reference counting

    pub fn retain(self: Object) Object {
        return Object { value: objc_retain(self.value) };
    }

    pub fn release(self: Object) {
        objc_release(self.value);
    }

    // -- property helpers (ports of zig-objc Object.getProperty /
    //    setProperty; strictly less performant than a direct msgSend).

    // Read a property by name. Uses the declared getter when the class
    // metadata names one ("G" attribute), the property name otherwise.
    pub fn getProperty(self: Object, name: []u8) u64 {
        var getter: u64 = propertyAccessorSel(self.value, name, "G");
        if (getter == 0) {
            getter = sel_registerName(name.ptr);
        }
        return rawSend0(self.value, getter);
    }

    pub fn getPropertyObj(self: Object, name: []u8) Object {
        return Object { value: self.getProperty(name) };
    }

    // Write a property by name. Uses the declared setter ("S" attribute)
    // when present, `setName:` otherwise. Property names longer than 250
    // bytes are ignored.
    pub fn setProperty(self: Object, name: []u8, v: u64) {
        var setter: u64 = propertyAccessorSel(self.value, name, "S");
        if (setter == 0) {
            if ((name.len == 0) || (name.len > 250)) {
                return;
            }
            // "set" + Name + ":" + NUL
            var buf: [256]u8 = [0; 256];
            buf[0] = 115;          // 's'
            buf[1] = 101;          // 'e'
            buf[2] = 116;          // 't'
            var first: u8 = name.ptr[0];
            if ((first >= 97) && (first <= 122)) {
                first = first - 32;   // toUpper
            }
            buf[3] = first;
            var i: u64 = 1;
            while (i < name.len) {
                buf[3 + i] = name.ptr[i];
                i = i + 1;
            }
            buf[3 + name.len] = 58;   // ':'
            setter = sel_registerName(buf.asPtr());
        }
        rawSend1(self.value, setter, v);
    }
};

// Look up the explicit getter/setter selector recorded in the property
// metadata (attribute "G" or "S"). 0 when absent.
fn propertyAccessorSel(obj: u64, name: []u8, attr: []u8) u64 {
    const cls: u64 = object_getClass(obj);
    if (cls == 0) {
        return 0;
    }
    const prop: u64 = class_getProperty(cls, name.ptr);
    if (prop == 0) {
        return 0;
    }
    const val: u64 = property_copyAttributeValue(prop, attr.ptr);
    if (val == 0) {
        return 0;
    }
    const p: *const[] u8 = val as *const[] u8;
    const result: u64 = sel_registerName(p);
    free(val as *mut[] u8);
    return result;
}

// ---------------------------------------------------------------------------
// AutoreleasePool
//
// zig-objc pairs init() with an explicit deinit(). Jam has linear drops,
// so the pool pops itself at scope exit:
//
//     {
//         var pool: AutoreleasePool = AutoreleasePool.init();
//         ... autoreleased work ...
//     }   // popped here

pub const AutoreleasePool = struct {
    ptr: u64,

    pub fn init() AutoreleasePool {
        return AutoreleasePool { ptr: objc_autoreleasePoolPush() };
    }

    // `cfn drop` (not `fn drop`) registers with MVS auto-drop, so the
    // pool actually pops at scope exit. A plain `fn drop` would never
    // fire — the pool would leak and never balance its push.
    cfn drop(self: mut AutoreleasePool) {
        objc_autoreleasePoolPop(self.ptr);
    }
};
