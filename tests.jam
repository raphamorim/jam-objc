// jam-objc test suite — ports of the inline `test` blocks in
// references/zig-objc/src/*.zig.
//
// Run with:  jam test -lobjc tests.jam   (or `make test`)
//
// Foundation classes (NSString, NSNumber, NSArray, ...) are loaded via
// dlopen because `jam` has no `-framework` linker flag.

const { assert } = import("test");
const { Option } = import("std").option;
const { eq } = import("std").string;
const objc = import("objc");
const { Object, Class, Sel, Property, Protocol, AutoreleasePool, sel } = import("objc");

// --- helpers ---------------------------------------------------------------

fn mustClass(name: []u8) Class {
    match (objc.getClass(name)) {
        Option(Class).Some(found) { return found; }
        Option(Class).None        { assert(0, 1); }
    }
    return Class { value: 0 };
}

fn mustProtocol(name: []u8) Protocol {
    match (objc.getProtocol(name)) {
        Option(Protocol).Some(found) { return found; }
        Option(Protocol).None        { assert(0, 1); }
    }
    return Protocol { value: 0 };
}

fn retainCount(obj: Object) u64 {
    return obj.msgSend0(sel("retainCount"));
}

fn nsString(s: []u8) Object {
    objc.loadFoundation();
    const cls: Class = mustClass("NSString");
    return cls.msgSendObj1(sel("stringWithUTF8String:"), s.ptr as u64);
}

fn utf8(obj: Object) []u8 {
    const p: u64 = obj.msgSend0(sel("UTF8String"));
    return objc.cstr(p as *const[] u8);
}

// --- sel.zig ----------------------------------------------------------------

tfn selRegisterAndName() {
    const s: Sel = Sel.registerName("yo");
    assert(eq(s.getName(), "yo") as u8, 1);
}

// --- class.zig: getClass ----------------------------------------------------

tfn getClassFound() {
    match (objc.getClass("NSObject")) {
        Option(Class).Some(found) { assert((found.value != 0) as u8, 1); }
        Option(Class).None        { assert(0, 1); }
    }
}

tfn getClassMissing() {
    match (objc.getClass("NoWay")) {
        Option(Class).Some(found) { assert(found.value, 1); }   // fail
        Option(Class).None        { assert(1, 1); }
    }
}

// --- class.zig / object.zig: msgSend basics ----------------------------------

tfn allocInitDealloc() {
    const NSObject: Class = mustClass("NSObject");

    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    assert((obj.value != 0) as u8, 1);
    assert(eq(obj.getClassName(), "NSObject") as u8, 1);
    obj.msgSend0(sel("init"));
    obj.msgSend0(sel("dealloc"));
}

tfn objectGetClass() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));

    match (obj.getClass()) {
        Option(Class).Some(cls) { assert((cls.value == NSObject.value) as u8, 1); }
        Option(Class).None      { assert(0, 1); }
    }
    obj.msgSend0(sel("dealloc"));
}

// --- object.zig: retain/release ----------------------------------------------

tfn retainRelease() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));
    assert(retainCount(obj), 1);

    obj.retain();
    assert(retainCount(obj), 2);

    obj.release();
    assert(retainCount(obj), 1);

    obj.msgSend0(sel("dealloc"));
}

// --- object.zig: msgSend with wrapper args -----------------------------------

tfn msgSendWithClassAndSelArgs() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));

    // -[NSObject isKindOfClass:]
    const isKind: u64 = obj.msgSend1(sel("isKindOfClass:"), NSObject.value);
    assert((isKind & 0xFF) as u8, 1);

    // -[NSObject respondsToSelector:]
    const responds: u64 = obj.msgSend1(sel("respondsToSelector:"), sel("init").value);
    assert((responds & 0xFF) as u8, 1);

    obj.msgSend0(sel("dealloc"));
}

// --- class.zig: getProperty / copyPropertyList -------------------------------

tfn classGetProperty() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");

    match (NSObject.getProperty("className")) {
        Option(Property).Some(prop) { assert(eq(prop.getName(), "className") as u8, 1); }
        Option(Property).None       { assert(0, 1); }
    }

    match (NSObject.getProperty("nope")) {
        Option(Property).Some(prop) { assert(prop.value, 1); }   // fail
        Option(Property).None       { assert(1, 1); }
    }
}

tfn copyPropertyList() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");
    var list = NSObject.copyPropertyList();
    assert((list.len > 0) as u8, 1);
    assert((list.at(0).value != 0) as u8, 1);
    // list drops here, freeing the runtime allocation
}

// --- protocol.zig -------------------------------------------------------------

tfn protocols() {
    objc.loadFoundation();
    // zig-objc uses NSFileManagerDelegate here, but a protocol is only
    // registered when a loaded image *references* it; with Foundation
    // dlopen'd (instead of linked) NSFileManagerDelegate is absent even
    // in plain C. NSURLSessionDelegate is always registered.
    const urlProto: Protocol = mustProtocol("NSURLSessionDelegate");
    assert(eq(urlProto.getName(), "NSURLSessionDelegate") as u8, 1);

    const objProto: Protocol = mustProtocol("NSObject");
    assert(urlProto.conformsToProtocol(objProto) as u8, 1);
    assert(urlProto.isEqual(urlProto) as u8, 1);
    assert(urlProto.isEqual(objProto) as u8, 0);

    match (objProto.getProperty("hash", true, true)) {
        Option(Property).Some(prop) { assert(eq(prop.getName(), "hash") as u8, 1); }
        Option(Property).None       { assert(0, 1); }
    }
}

tfn classConformsToProtocol() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");
    const objProto: Protocol = mustProtocol("NSObject");
    assert(NSObject.conformsToProtocol(objProto) as u8, 1);
}

// --- class.zig: allocateClassPair + replaceMethod ------------------------------

fn hash69(target: u64, op: u64) u64 {
    return 69;
}

tfn allocateClassPairAndReplaceMethod() {
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_object")) {
        Option(Class).Some(cls) { myClass = cls; }
        Option(Class).None      { assert(0, 1); }
    }

    myClass.replaceMethod("hash", hash69 as u64);
    objc.registerClassPair(myClass);

    const obj: Object = myClass.msgSendObj0(sel("alloc"));
    assert(obj.msgSend0(sel("hash")), 69);
    obj.msgSend0(sel("dealloc"));

    objc.disposeClassPair(myClass);
}

// --- class.zig: addMethod -------------------------------------------------------

fn myAddition(target: u64, op: u64, a: i32, b: i32) i32 {
    return a + b;
}

tfn addMethod() {
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_class")) {
        Option(Class).Some(cls) { myClass = cls; }
        Option(Class).None      { assert(0, 1); }
    }

    assert(myClass.addMethod("my_addition", myAddition as u64, "i@:ii") as u8, 1);
    objc.registerClassPair(myClass);

    const obj: Object = myClass.msgSendObj0(sel("alloc")).msgSendObj0(sel("init"));
    assert(obj.msgSend2(sel("my_addition"), 2, 3), 5);
    obj.msgSend0(sel("dealloc"));
}

// --- class.zig: ivars ------------------------------------------------------------

tfn ivars() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_ivar_object")) {
        Option(Class).Some(cls) { myClass = cls; }
        Option(Class).None      { assert(0, 1); }
    }

    assert(myClass.addIvar("my_ivar") as u8, 1);
    objc.registerClassPair(myClass);

    const obj: Object = myClass.msgSendObj0(sel("alloc"));
    const ivarVal: Object = nsString("69---nice");
    obj.setInstanceVariable("my_ivar", ivarVal);
    const back: Object = obj.getInstanceVariable("my_ivar");
    assert(eq(utf8(back), "69---nice") as u8, 1);

    obj.msgSend0(sel("dealloc"));
}

// --- object.zig: property helpers -------------------------------------------------

tfn getPropertyHelper() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));

    const name: Object = obj.getPropertyObj("className");
    assert(eq(utf8(name), "NSObject") as u8, 1);

    obj.msgSend0(sel("dealloc"));
}
