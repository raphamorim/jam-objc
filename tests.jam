// jam test -lobjc tests.jam
// note: foundation classes (NSString, NSNumber, NSArray, etc) are loaded via dlopen because jam has no -framework linker flag yet

const { assert } = import("test");
const { Option } = import("std").option;
const { eq } = import("std").string;
const objc = import("objc");
const { Object, Class, Sel, Property, Protocol, AutoreleasePool, sel } = import("objc");
const { Iterator } = import("iterator");
const block = import("block");
const { Block } = import("block");

fn mustClass(name: []u8) Class {
    match (objc.getClass(name)) {
        Some(found) {
            return found;
        }
        None {
            assert(0, 1);
        }
    }
    return Class {
        value: 0
    };
}

fn mustProtocol(name: []u8) Protocol {
    match (objc.getProtocol(name)) {
        Some(found) {
            return found;
        }
        None {
            assert(0, 1);
        }
    }
    return Protocol {
        value: 0
    };
}

fn retainCount(obj: Object) u64 {
    return obj.msgSend(u64, sel("retainCount"));
}

fn nsString(s: []u8) Object {
    objc.loadFoundation();
    const cls = mustClass("NSString");
    return cls.msgSend(Object, sel("stringWithUTF8String:"), s.ptr as u64);
}

fn utf8(obj: Object) []u8 {
    const p = obj.msgSend(u64, sel("UTF8String"));
    return objc.cstr(p as *const[] u8);
}

tfn selRegisterAndName() {
    const s = Sel.registerName("yo");
    assert(eq(s.getName(), "yo") as u8, 1);
}

tfn getClassFound() {
    match (objc.getClass("NSObject")) {
        Some(found) {
            assert((found.value != 0) as u8, 1);
        }
        None {
            assert(0, 1);
        }
    }
}

tfn getClassMissing() {
    match (objc.getClass("NoWay")) {
        Some(found) {
            assert(found.value, 1);
        }
        None {
            assert(1, 1);
        }
    }
}

tfn allocInitDealloc() {
    const NSObject = mustClass("NSObject");
    const obj = NSObject.msgSend(Object, sel("alloc"));
    assert((obj.value != 0) as u8, 1);
    assert(eq(obj.getClassName(), "NSObject") as u8, 1);
    obj.msgSend(u64, sel("init"));
    obj.msgSend(void, sel("dealloc"));
}

tfn objectGetClass() {
    const NSObject = mustClass("NSObject");
    const obj = NSObject.msgSend(Object, sel("alloc"));
    obj.msgSend(u64, sel("init"));

    match (obj.getClass()) {
        Some(cls) {
            assert(
                (cls.value == NSObject.value) as u8,
                1
            );
        }
        None {
            assert(0, 1);
        }
    }
    obj.msgSend(void, sel("dealloc"));
}

tfn retainRelease() {
    const NSObject = mustClass("NSObject");
    const obj = NSObject.msgSend(Object, sel("alloc"));
    obj.msgSend(u64, sel("init"));
    assert(retainCount(obj), 1);

    obj.retain();
    assert(retainCount(obj), 2);

    obj.release();
    assert(retainCount(obj), 1);

    obj.msgSend(void, sel("dealloc"));
}

tfn msgSendWithClassAndSelArgs() {
    const NSObject = mustClass("NSObject");
    const obj = NSObject.msgSend(Object, sel("alloc"));
    obj.msgSend(u64, sel("init"));

    // -[NSObject isKindOfClass:]
    const isKind = obj.msgSend(u64, sel("isKindOfClass:"), NSObject.value);
    assert((isKind & 0xFF) as u8, 1);

    // -[NSObject respondsToSelector:]
    const responds = obj.msgSend(u64, sel("respondsToSelector:"), sel("init").value);
    assert((responds & 0xFF) as u8, 1);

    obj.msgSend(void, sel("dealloc"));
}

tfn classGetProperty() {
    objc.loadFoundation();
    const NSObject = mustClass("NSObject");

    match (NSObject.getProperty("className")) {
        Some(prop) {
            assert(
                eq(prop.getName(), "className") as u8,
                1
            );
        }
        None {
            assert(0, 1);
        }
    }

    match (NSObject.getProperty("nope")) {
        Some(prop) {
            assert(prop.value, 1);
        }
        None {
            assert(1, 1);
        }
    }
}

tfn copyPropertyList() {
    objc.loadFoundation();
    const NSObject = mustClass("NSObject");
    var list = NSObject.copyPropertyList();
    assert((list.len > 0) as u8, 1);
    assert((list.at(0).value != 0) as u8, 1);
    // note: list drops here, freeing the runtime allocation
}

tfn protocols() {
    objc.loadFoundation();
    // mitchell's zig project uses NSFileManagerDelegate here, but a protocol is only registered when a loaded image *references* it
    //with Foundation dlopen'd (instead of linked) NSFileManagerDelegate is absent even in plain C, NSURLSessionDelegate is always registered
    const urlProto: Protocol = mustProtocol("NSURLSessionDelegate");
    assert(eq(urlProto.getName(), "NSURLSessionDelegate") as u8, 1);

    const objProto: Protocol = mustProtocol("NSObject");
    assert(urlProto.conformsToProtocol(objProto) as u8, 1);
    assert(urlProto.isEqual(urlProto) as u8, 1);
    assert(urlProto.isEqual(objProto) as u8, 0);

    match (objProto.getProperty("hash", true, true)) {
        Some(prop) {
            assert(eq(prop.getName(), "hash") as u8, 1);
        }
        None {
            assert(0, 1);
        }
    }
}

tfn classConformsToProtocol() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");
    const objProto: Protocol = mustProtocol("NSObject");
    assert(NSObject.conformsToProtocol(objProto) as u8, 1);
}

fn hash69(target: u64, op: u64) u64 {
    return 69;
}

tfn allocateClassPairAndReplaceMethod() {
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_object")) {
        Some(cls) { myClass = cls; }
        None      { assert(0, 1); }
    }

    myClass.replaceMethod("hash", hash69 as u64);
    objc.registerClassPair(myClass);

    const obj: Object = myClass.msgSend(Object, sel("alloc"));
    assert(obj.msgSend(u64, sel("hash")), 69);
    obj.msgSend(void, sel("dealloc"));

    objc.disposeClassPair(myClass);
}

fn myAddition(target: u64, op: u64, a: i32, b: i32) i32 {
    return a + b;
}

tfn addMethod() {
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_class")) {
        Some(cls) { myClass = cls; }
        None      { assert(0, 1); }
    }

    assert(myClass.addMethod("my_addition", myAddition as u64, "i@:ii") as u8, 1);
    objc.registerClassPair(myClass);

    const alloced: Object = myClass.msgSend(Object, sel("alloc"));
    const obj: Object = alloced.msgSend(Object, sel("init"));
    assert(obj.msgSend(i32, sel("my_addition"), 2 as i32, 3 as i32) as u64, 5);
    obj.msgSend(void, sel("dealloc"));
}

tfn ivars() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");

    var myClass: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_ivar_object")) {
        Some(cls) { myClass = cls; }
        None      { assert(0, 1); }
    }

    assert(myClass.addIvar("my_ivar") as u8, 1);
    objc.registerClassPair(myClass);

    const obj: Object = myClass.msgSend(Object, sel("alloc"));
    const ivarVal: Object = nsString("69!!!!yey!!!nice");
    obj.setInstanceVariable("my_ivar", ivarVal);
    const back: Object = obj.getInstanceVariable("my_ivar");
    assert(eq(utf8(back), "69!!!!yey!!!nice") as u8, 1);

    obj.msgSend(void, sel("dealloc"));
}

tfn getPropertyHelper() {
    objc.loadFoundation();
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSend(Object, sel("alloc"));
    obj.msgSend(u64, sel("init"));

    const name: Object = obj.getPropertyObj("className");
    assert(eq(utf8(name), "NSObject") as u8, 1);

    obj.msgSend(void, sel("dealloc"));
}

fn subclassInit(target: u64, op: u64) u64 {
    const obj: Object = Object.fromId(target);
    var NSObject: Class = Class { value: 0 };
    match (objc.getClass("NSObject")) {
        Some(c) { NSObject = c; }
        None    { return 0; }
    }
    obj.msgSendSuper(u64, NSObject, sel("init"));
    return target;
}

tfn subclassSuperInit() {
    const NSObject: Class = mustClass("NSObject");

    var sub: Class = Class { value: 0 };
    match (objc.allocateClassPair(NSObject, "jam_subclass")) {
        Some(cls) { sub = cls; }
        None      { assert(0, 1); }
    }

    sub.replaceMethod("init", subclassInit as u64);
    objc.registerClassPair(sub);

    const obj: Object = sub.msgSend(Object, sel("alloc"));
    const inited: u64 = obj.msgSend(u64, sel("init"));
    assert((inited == obj.value) as u8, 1);
    obj.msgSend(void, sel("dealloc"));

    objc.disposeClassPair(sub);
}

tfn floatReturn() {
    objc.loadFoundation();
    const NSDate: Class = mustClass("NSDate");
    const date: Object = NSDate.msgSend(Object, sel("date"));
    const secs: f64 = date.msgSend(f64, sel("timeIntervalSince1970"));
    assert((secs > 1700000000.0) as u8, 1);
}

tfn floatArgRoundTrip() {
    objc.loadFoundation();
    const NSNumber: Class = mustClass("NSNumber");
    const num: Object = NSNumber.msgSend(Object, sel("numberWithDouble:"), 3.5);
    assert((num.msgSend(f64, sel("doubleValue")) == 3.5) as u8, 1);
}

tfn taggedPointer() {
    objc.loadFoundation();
    const NSNumber: Class = mustClass("NSNumber");
    // small NSNumbers are tagged pointers, not heap objects
    const num: Object = NSNumber.msgSend(Object, sel("numberWithChar:"), 5 as u64);
    assert(num.msgSend(u64, sel("charValue")) & 0xFF, 5);
}

tfn autoreleasePool() {
    objc.loadFoundation();
    var pool: AutoreleasePool = AutoreleasePool.init();
    assert((pool.ptr != 0) as u8, 1);
    // stringWithUTF8String already returns an autoreleased string it's reclaimed when the pool pops at scope exit
    const pooled: Object = nsString("autoreleased");
    assert((pooled.value != 0) as u8, 1);
    // pool's cfn drop pops here, releasing the autoreleased string!!!
}

tfn iterateNSArray() {
    objc.loadFoundation();
    const NSMutableArray: Class = mustClass("NSMutableArray");
    const NSNumber: Class = mustClass("NSNumber");

    const array: Object = NSMutableArray.msgSend(Object, sel("arrayWithCapacity:"), 10 as u64);
    for i in 0:10 {
        const num: Object = NSNumber.msgSend(Object, sel("numberWithInt:"), i as u64);
        array.msgSend(void, sel("addObject:"), num.value);
    }

    var result: u64 = 0;
    var it: Iterator = Iterator.init(array);
    loop {
        match (it.next()) {
            Some(elem) {
                result = result * 10 + elem.msgSend(u64, sel("intValue"));
            }
            None { break; }
        }
    }
    assert(result, 123456789);
}

const AddCaps = struct { x: i32, y: i32 };
const AddBlock = Block(AddCaps);

fn addBlockImpl(ctx: u64) i32 {
    var caps: *const AddCaps = AddBlock.capturesFrom(ctx);
    return caps.*.x + caps.*.y;
}

tfn blockInvoke() {
    var b: AddBlock = AddBlock.init(AddCaps { x: 2, y: 3 }, addBlockImpl as u64);
    assert(block.invoke0i32((&b) as u64), 5);

    // copy to the heap and invoke the copy
    const copied: u64 = block.copy((&b) as u64);
    assert(block.invoke0i32(copied), 5);
    block.release(copied);

    b.deinit();
}

// NSAffineTransformStruct: six CGFloats, not an HFA (homogeneous floating-point aggregate)... so the C ABI passes it as a caller-copied pointer and returns it through sret in x8
const TransformStruct = struct {
    m11: f64, m12: f64, m21: f64, m22: f64, tx: f64, ty: f64,
};

tfn bigStructByValueRoundTrip() {
    objc.loadFoundation();
    const cls: Class = mustClass("NSAffineTransform");
    const t: Object = cls.msgSend(Object, sel("transform"));

    const m: TransformStruct = t.msgSend(TransformStruct, sel("transformStruct"));
    assert((m.m11 == 1.0) as u8, 1);
    assert((m.m22 == 1.0) as u8, 1);
    assert((m.m12 == 0.0) as u8, 1);

    var moved: TransformStruct = m;
    moved.tx = 42.0;
    moved.ty = 7.0;
    t.msgSend(void, sel("setTransformStruct:"), moved);

    const back: TransformStruct = t.msgSend(TransformStruct, sel("transformStruct"));
    assert((back.tx == 42.0) as u8, 1);
    assert((back.ty == 7.0) as u8, 1);
    assert((back.m11 == 1.0) as u8, 1);
}
