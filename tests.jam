// jam-objc test suite — ports of the inline `test` blocks in
// references/zig-objc/src/*.zig.
//
// Run with:  jam test -lobjc tests.jam   (or `make test`)
//
// Foundation classes (NSString, NSNumber, NSArray, ...) are loaded via
// dlopen because `jam` has no `-framework` linker flag.

const { assert } = import("test");
const { Option } = import("std").option;
const { eq } = import("std").string;
const objc = import("objc");
const { Object, Class, Sel, Property, Protocol, AutoreleasePool, sel } = import("objc");

// --- helpers ---------------------------------------------------------------

fn mustClass(name: []u8) Class {
    match (objc.getClass(name)) {
        Option(Class).Some(found) { return found; }
        Option(Class).None        { assert(0, 1); }
    }
    return Class { value: 0 };
}

fn mustProtocol(name: []u8) Protocol {
    match (objc.getProtocol(name)) {
        Option(Protocol).Some(found) { return found; }
        Option(Protocol).None        { assert(0, 1); }
    }
    return Protocol { value: 0 };
}

fn retainCount(obj: Object) u64 {
    return obj.msgSend0(sel("retainCount"));
}

fn nsString(s: []u8) Object {
    objc.loadFoundation();
    const cls: Class = mustClass("NSString");
    return cls.msgSendObj1(sel("stringWithUTF8String:"), s.ptr as u64);
}

fn utf8(obj: Object) []u8 {
    const p: u64 = obj.msgSend0(sel("UTF8String"));
    return objc.cstr(p as *const[] u8);
}

// --- sel.zig ----------------------------------------------------------------

tfn selRegisterAndName() {
    const s: Sel = Sel.registerName("yo");
    assert(eq(s.getName(), "yo") as u8, 1);
}

// --- class.zig: getClass ----------------------------------------------------

tfn getClassFound() {
    match (objc.getClass("NSObject")) {
        Option(Class).Some(found) { assert((found.value != 0) as u8, 1); }
        Option(Class).None        { assert(0, 1); }
    }
}

tfn getClassMissing() {
    match (objc.getClass("NoWay")) {
        Option(Class).Some(found) { assert(found.value, 1); }   // fail
        Option(Class).None        { assert(1, 1); }
    }
}

// --- class.zig / object.zig: msgSend basics ----------------------------------

tfn allocInitDealloc() {
    const NSObject: Class = mustClass("NSObject");

    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    assert((obj.value != 0) as u8, 1);
    assert(eq(obj.getClassName(), "NSObject") as u8, 1);
    obj.msgSend0(sel("init"));
    obj.msgSend0(sel("dealloc"));
}

tfn objectGetClass() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));

    match (obj.getClass()) {
        Option(Class).Some(cls) { assert((cls.value == NSObject.value) as u8, 1); }
        Option(Class).None      { assert(0, 1); }
    }
    obj.msgSend0(sel("dealloc"));
}

// --- object.zig: retain/release ----------------------------------------------

tfn retainRelease() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));
    assert(retainCount(obj), 1);

    obj.retain();
    assert(retainCount(obj), 2);

    obj.release();
    assert(retainCount(obj), 1);

    obj.msgSend0(sel("dealloc"));
}

// --- object.zig: msgSend with wrapper args -----------------------------------

tfn msgSendWithClassAndSelArgs() {
    const NSObject: Class = mustClass("NSObject");
    const obj: Object = NSObject.msgSendObj0(sel("alloc"));
    obj.msgSend0(sel("init"));

    // -[NSObject isKindOfClass:]
    const isKind: u64 = obj.msgSend1(sel("isKindOfClass:"), NSObject.value);
    assert((isKind & 0xFF) as u8, 1);

    // -[NSObject respondsToSelector:]
    const responds: u64 = obj.msgSend1(sel("respondsToSelector:"), sel("init").value);
    assert((responds & 0xFF) as u8, 1);

    obj.msgSend0(sel("dealloc"));
}
