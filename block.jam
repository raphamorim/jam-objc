// based on zig-objc/src/block.zig, but simplified. for example, no embedded signature string (zig-objc encodes one at comptime)
// block descriptor is malloc'd per init and freed by deinit. only call deinit after every runtime copy of the block has been released, heap copies share the descriptor
//
//     const Caps = struct { x: i32, y: i32 };
//     const BlockCaps = Block(Caps);
//
//     fn addImpl(ctx: u64) i32 {
//         var caps: *const Caps = BlockCaps.capturesFrom(ctx);
//         return caps.*.x + caps.*.y;
//     }
//
//     var b = BlockCaps.init(Caps { x: 2, y: 3 }, addImpl as u64);
//     const r: i32 = invoke0i32((&b) as u64);
//     b.deinit();

// TODO: should deinit be on jam cfn?
const { dlsym, malloc, free } = import("objc");

pub extern fn _Block_copy(b: u64) u64;
pub extern fn _Block_release(b: u64);

pub const BlockDescriptor = struct {
    reserved: u64,
    size: u64,
};

// block literal header layout (ABI-fixed, see clang BlockLanguageSpec for more info)
//>  isa(8) flags(4) reserved(4) invoke(8) descriptor(8) captures...
pub const HEADER_SIZE: u64 = 32;

fn stackBlockIsa() u64 {
    // TODO: no `extern var` in Jam, so the _NSConcreteStackBlock class object is fetched via dlsym(RTLD_DEFAULT, ...).
    const name: []u8 = "_NSConcreteStackBlock";
    return dlsym(0xFFFFFFFFFFFFFFFE, name.ptr);
}

pub fn capturesAddr(blockPtr: u64) u64 {
    return blockPtr + HEADER_SIZE;
}

// malloc + populate a descriptor
fn newDescriptor(size: u64) u64 {
    var desc: *mut BlockDescriptor = malloc(@sizeOf(BlockDescriptor)) as *mut BlockDescriptor;
    desc.* = BlockDescriptor { reserved: 0, size: size };
    return desc as u64;
}

pub fn Block(Captures: type) type {
    return struct {
        isa: u64,
        flags: i32,
        reserved: i32,
        invoke: u64,
        descriptor: u64,
        captures: Captures,

        // `invokeFn` is a Jam function coerced with `as u64`. Its first
        // parameter is the block context pointer (u64); recover the
        // captures inside via `capturesAddr(ctx)`.
        pub fn init(caps: Captures, invokeFn: u64) Self {
            return Self {
                isa: stackBlockIsa(),
                flags: 0,
                reserved: 0,
                invoke: invokeFn,
                descriptor: newDescriptor(HEADER_SIZE + @sizeOf(Captures)),
                captures: caps,
            };
        }

        // The typed captures of a live block, recovered inside its
        // invoke fn from the context pointer.
        pub fn capturesFrom(ctx: u64) *const Captures {
            return capturesAddr(ctx) as *const Captures;
        }

        pub fn deinit(self: mut Self) {
            if (self.descriptor != 0) {
                free(self.descriptor as *mut[] u8);
                self.descriptor = 0;
            }
        }
    };
}

pub fn copy(blockPtr: u64) u64 {
    return _Block_copy(blockPtr);
}

pub fn release(blockPtr: u64) {
    _Block_release(blockPtr);
}

pub const Inv0 = union { addr: u64, f: fn(u64) u64 };
pub const Inv1 = union { addr: u64, f: fn(u64, u64) u64 };
pub const Inv2 = union { addr: u64, f: fn(u64, u64, u64) u64 };
pub const Inv0I32 = union { addr: u64, f: fn(u64) i32 };

fn invokeAddr(blockPtr: u64) u64 {
    var p: *const u64 = (blockPtr + 16) as *const u64;
    return p.*;
}

// TODO: do only invoke()
pub fn invoke0(blockPtr: u64) u64 {
    var caster: Inv0 = Inv0 { addr: invokeAddr(blockPtr) };
    var f: fn(u64) u64 = caster.f;
    return f(blockPtr);
}

pub fn invoke1(blockPtr: u64, a: u64) u64 {
    var caster: Inv1 = Inv1 { addr: invokeAddr(blockPtr) };
    var f: fn(u64, u64) u64 = caster.f;
    return f(blockPtr, a);
}

pub fn invoke2(blockPtr: u64, a: u64, b: u64) u64 {
    var caster: Inv2 = Inv2 { addr: invokeAddr(blockPtr) };
    var f: fn(u64, u64, u64) u64 = caster.f;
    return f(blockPtr, a, b);
}

pub fn invoke0i32(blockPtr: u64) i32 {
    var caster: Inv0I32 = Inv0I32 { addr: invokeAddr(blockPtr) };
    var f: fn(u64) i32 = caster.f;
    return f(blockPtr);
}
