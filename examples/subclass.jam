// jam run -lobjc subclass.jam
//
// Builds JamCounter — an NSObject subclass with a `count` ivar and
// increment/value methods — entirely through the runtime
// (allocateClassPair / addIvar / addMethod / registerClassPair), then
// uses it like any other ObjC class. The count lives in the ivar as an
// NSNumber, so every instance carries its own state and the method
// bodies are ordinary jam fns called back through the C ABI.

const objc = import("../objc");
const { Object, Class, sel } = import("../objc");
const { Option } = import("std").option;
const { println } = import("std/fmt");

fn mustClass(name: []u8) Class {
    match (objc.getClass(name)) {
        Option(Class).Some(c) { return c; }
        Option(Class).None    { return Class { value: 0 }; }
    }
    return Class { value: 0 };
}

fn nsNumber(n: u64) Object {
    const cls: Class = mustClass("NSNumber");
    return cls.msgSend(Object, sel("numberWithUnsignedLong:"), n);
}

// --- JamCounter method implementations --------------------------------
// Each IMP is a plain jam fn taking (self, _cmd, ...) as u64s, coerced
// with `as u64` when installed; the runtime calls it like any C IMP.

// - (id)init — chain to super, then zero the counter.
fn counterInit(target: u64, op: u64) u64 {
    const self: Object = Object.fromId(target);
    self.msgSendSuper(u64, mustClass("NSObject"), sel("init"));
    self.setInstanceVariable("count", nsNumber(0));
    return target;
}

// - (void)increment — read the NSNumber, store back n+1.  Encoding "v@:".
fn counterIncrement(target: u64, op: u64) {
    const self: Object = Object.fromId(target);
    const boxed: Object = self.getInstanceVariable("count");
    const n: u64 = boxed.msgSend(u64, sel("unsignedLongValue"));
    self.setInstanceVariable("count", nsNumber(n + 1));
}

// - (unsigned long)value — the current count.  Encoding "Q@:".
fn counterValue(target: u64, op: u64) u64 {
    const self: Object = Object.fromId(target);
    const boxed: Object = self.getInstanceVariable("count");
    return boxed.msgSend(u64, sel("unsignedLongValue"));
}

fn defineCounterClass() Class {
    var cls: Class = Class { value: 0 };
    match (objc.allocateClassPair(mustClass("NSObject"), "JamCounter")) {
        Option(Class).Some(c) { cls = c; }
        Option(Class).None    { return cls; }
    }

    // Ivars and methods must land between allocate and register.
    cls.addIvar("count");                          // one `id`-typed slot
    cls.replaceMethod("init", counterInit as u64); // override NSObject's
    cls.addMethod("increment", counterIncrement as u64, "v@:");
    cls.addMethod("value", counterValue as u64, "Q@:");
    objc.registerClassPair(cls);
    return cls;
}

fn newCounter(cls: Class) Object {
    const obj: Object = cls.msgSend(Object, sel("alloc"));
    return obj.msgSend(Object, sel("init"));
}

fn main() {
    if (!objc.loadFoundation()) {
        println("failed to load Foundation");
        return;
    }

    const cls: Class = defineCounterClass();
    if (cls.value == 0) {
        println("failed to allocate JamCounter");
        return;
    }

    // Two instances — state is per-object, in the ivar.
    const a: Object = newCounter(cls);
    const b: Object = newCounter(cls);
    for i in 0:3 {
        a.msgSend(void, sel("increment"));
    }
    b.msgSend(void, sel("increment"));

    const name: []u8 = a.getClassName();
    const aVal: u64 = a.msgSend(u64, sel("value"));
    const bVal: u64 = b.msgSend(u64, sel("value"));
    println("{name}: a counted to {aVal}, b counted to {bVal}");

    // It's a real ObjC class — runtime introspection works on it.
    const responds: bool = cls.respondsToSelector(sel("increment"));
    const size: u64 = cls.getInstanceSize();
    println("respondsToSelector(increment): {responds}; instance size: {size} bytes");

    a.msgSend(void, sel("dealloc"));
    b.msgSend(void, sel("dealloc"));
}
