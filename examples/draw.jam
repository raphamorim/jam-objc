// jam-objc example: custom drawing in a native macOS window.
//
// Subclasses NSView at runtime (allocateClassPair + replaceMethod) and
// overrides -drawRect: with a jam fn that paints through NSColor and
// NSBezierPath — three translucent circles over a dark background.
// AppKit calls straight back into jam code every time the view redraws
// (try resizing the window).
//
// Build & run (from this folder):
//     jam run -lobjc draw.jam

const objc = import("../objc");
const { Object, Class, sel } = import("../objc");
const { Option } = import("std").option;
const { println } = import("std/fmt");

const NSWindowStyleMaskTitled: u64 = 1;
const NSWindowStyleMaskClosable: u64 = 2;
const NSWindowStyleMaskMiniaturizable: u64 = 4;
const NSWindowStyleMaskResizable: u64 = 8;
const NSBackingStoreBuffered: u64 = 2;
const NSApplicationActivationPolicyRegular: u64 = 0;

const NSRect = struct { x: f64, y: f64, w: f64, h: f64 };

fn mustClass(name: []u8) Class {
    match (objc.getClass(name)) {
        Some(c) { return c; }
        None    { return Class { value: 0 }; }
    }
    return Class { value: 0 };
}

fn allocInit(name: []u8) Object {
    const c: Class = mustClass(name);
    const obj: Object = c.msgSend(Object, sel("alloc"));
    return obj.msgSend(Object, sel("init"));
}

fn nsString(s: []u8) Object {
    const nsstr: Class = mustClass("NSString");
    return nsstr.msgSend(Object, sel("stringWithUTF8String:"), s.ptr as u64);
}

// --- drawing -----------------------------------------------------------

// [NSColor colorWithSRGBRed:...] then -setFill — the fill color for
// whatever gets filled next. Four f64 args ride in v0–v3.
fn setFill(r: f64, g: f64, b: f64, a: f64) {
    const cls: Class = mustClass("NSColor");
    const color: Object = cls.msgSend(Object,
        sel("colorWithSRGBRed:green:blue:alpha:"), r, g, b, a);
    color.msgSend(void, sel("setFill"));
}

// Fill the oval inscribed in `rect` — NSRect travels by value into
// +bezierPathWithOvalInRect:.
fn fillOval(rect: NSRect) {
    const cls: Class = mustClass("NSBezierPath");
    const path: Object = cls.msgSend(Object,
        sel("bezierPathWithOvalInRect:"), rect);
    path.msgSend(void, sel("fill"));
}

// The -drawRect: override. AppKit invokes it through the C ABI like any
// IMP; the NSRect argument arrives in v0–v3 and is simply ignored — we
// repaint from the view's bounds instead.
fn canvasDrawRect(target: u64, op: u64) {
    const view: Object = Object.fromId(target);
    const bounds: NSRect = view.msgSend(NSRect, sel("bounds"));

    // Dark background across the whole view.
    setFill(0.10, 0.10, 0.13, 1.0);
    const cls: Class = mustClass("NSBezierPath");
    cls.msgSend(void, sel("fillRect:"), bounds);

    // Three overlapping translucent circles, centered as a group.
    const d: f64 = 180.0;
    const cx: f64 = (bounds.w - d) / 2.0;
    const cy: f64 = (bounds.h - d) / 2.0;

    setFill(0.90, 0.25, 0.30, 0.6);   // red
    fillOval(NSRect { x: cx - 50.0, y: cy + 30.0, w: d, h: d });
    setFill(0.25, 0.80, 0.40, 0.6);   // green
    fillOval(NSRect { x: cx + 50.0, y: cy + 30.0, w: d, h: d });
    setFill(0.25, 0.45, 0.95, 0.6);   // blue
    fillOval(NSRect { x: cx, y: cy - 50.0, w: d, h: d });
}

// NSView subclass with our drawRect:, built at runtime.
fn defineCanvasClass() Class {
    const nsview: Class = mustClass("NSView");
    var cls: Class = Class { value: 0 };
    match (objc.allocateClassPair(nsview, "JamCanvas")) {
        Option(Class).Some(c) { cls = c; }
        Option(Class).None    { return cls; }
    }
    cls.replaceMethod("drawRect:", canvasDrawRect as u64);
    objc.registerClassPair(cls);
    return cls;
}

// --- boilerplate shared with window.jam ---------------------------------

fn installMenu(app: Object) {
    const menubar: Object = allocInit("NSMenu");
    const appItem: Object = allocInit("NSMenuItem");
    menubar.msgSend(void, sel("addItem:"), appItem.value);
    app.msgSend(void, sel("setMainMenu:"), menubar.value);

    const appMenu: Object = allocInit("NSMenu");
    const itemCls: Class = mustClass("NSMenuItem");
    const quitItem: Object = itemCls.msgSend(Object, sel("alloc"));
    quitItem.msgSend(u64,
        sel("initWithTitle:action:keyEquivalent:"),
        nsString("Quit").value, sel("terminate:").value,
        nsString("q").value);
    appMenu.msgSend(void, sel("addItem:"), quitItem.value);
    appItem.msgSend(void, sel("setSubmenu:"), appMenu.value);
}

fn appShouldTerminate(selfId: u64, op: u64, sender: u64) u8 {
    return 1;  // YES
}

fn installDelegate(app: Object) {
    const nsobject: Class = mustClass("NSObject");
    var delCls: Class = Class { value: 0 };
    match (objc.allocateClassPair(nsobject, "JamDrawDelegate")) {
        Option(Class).Some(c) { delCls = c; }
        Option(Class).None    { return; }
    }
    delCls.addMethod("applicationShouldTerminateAfterLastWindowClosed:",
                     appShouldTerminate as u64, "B@:@");
    objc.registerClassPair(delCls);
    const delegate: Object = delCls.msgSend(Object, sel("alloc"));
    delegate.msgSend(u64, sel("init"));
    app.msgSend(void, sel("setDelegate:"), delegate.value);
}

fn main() {
    if (!objc.loadAppKit()) {
        println("failed to load AppKit");
        return;
    }

    const appCls: Class = mustClass("NSApplication");
    const app: Object = appCls.msgSend(Object, sel("sharedApplication"));
    app.msgSend(void, sel("setActivationPolicy:"),
                NSApplicationActivationPolicyRegular);
    installMenu(app);
    installDelegate(app);

    const style: u64 = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
                       NSWindowStyleMaskMiniaturizable |
                       NSWindowStyleMaskResizable;
    var frame: NSRect = NSRect { x: 0.0, y: 0.0, w: 480.0, h: 360.0 };
    const winCls: Class = mustClass("NSWindow");
    const winAlloc: Object = winCls.msgSend(Object, sel("alloc"));
    const win: Object = winAlloc.msgSend(Object,
        sel("initWithContentRect:styleMask:backing:defer:"),
        frame, style, NSBackingStoreBuffered, 0 as i64);
    win.msgSend(void, sel("setTitle:"), nsString("jam-objc draw").value);

    // The whole content view is our runtime-built canvas.
    const canvasCls: Class = defineCanvasClass();
    if (canvasCls.value == 0) {
        println("failed to allocate JamCanvas");
        return;
    }
    const canvasAlloc: Object = canvasCls.msgSend(Object, sel("alloc"));
    const canvas: Object = canvasAlloc.msgSend(Object,
        sel("initWithFrame:"), frame);
    win.msgSend(void, sel("setContentView:"), canvas.value);

    win.msgSend(void, sel("center"));
    win.msgSend(void, sel("makeKeyAndOrderFront:"), 0 as u64);
    app.msgSend(void, sel("activateIgnoringOtherApps:"), 1 as u64);

    println("window open — jam paints every drawRect:; Cmd-Q to quit");
    app.msgSend(void, sel("run"));
}
